modules = ["nodejs-20", "web", "bash"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

# Freebuff/Replit run configuration — explicit table form so the preview
# runner reads the real command ("npm run dev") instead of the bare key name.
[run]
cmd = "npm run dev"

[nix]
channel = "stable-25_05"

# [deployment] — Replit autoscale deploy config removed from the active file
# because the bare `run` key inside it was misread by the preview runner as the
# dev command ("run: command not found"). Deployment now goes through
# Freebuff hosting (freebuff-deploy) / Docker. Uncomment to restore Replit
# autoscale deploys:
# [deployment]
# deploymentTarget = "autoscale"
# build = ["npm", "run", "build"]
# run = ["node", "./dist/index.js"]

[env]
PORT = "5000"

[workflows]
# Run button points straight at the real workflow (no wrapper). The removed
# "Project" wrapper only contained a `workflow.run` task whose bare `run`
# token the preview runner misread as the dev command ("run: command not
# found").
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_log_in_with_replit:1.0.0", "javascript_database:1.0.0", "javascript_supabase:1.0.0", "javascript_openai:1.0.0"]
expertMode = true
stack = "GAMESTACK_JS"

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "5000"
SESSION_COOKIE_SECURE = "true"
SESSION_COOKIE_SAME_SITE = "none"

[[ports]]
localPort = 5000
externalPort = 80
